# Server-side only — read by netlify/functions/audit-data.mts, never bundled
# into client JS. Set these as environment variables in the Netlify UI for
# production (Site settings -> Environment variables); for local dev with
# `npm run dev:netlify`, put them in a git-ignored .env file at the project root.

# n8n webhook that returns { MIC: [...], waba_quality_checks: [...] }
N8N_URL=https://your-n8n-domain/webhook/audit-data

# Value of the header your "Dashboard Auth" credential expects
N8N_API_KEY=your-secret-value

# Header name configured on the Webhook node's Header Auth credential (default: X-Api-Key)
N8N_API_KEY_HEADER=X-Api-Key
