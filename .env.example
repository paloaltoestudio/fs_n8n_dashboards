# n8n webhook that returns { MIC: [...], waba_quality_checks: [...] }
VITE_API_URL=https://your-n8n-domain/webhook/audit-data

# Value of the header your "Dashboard Auth" credential expects
VITE_API_KEY=your-secret-value

# Header name configured on the Webhook node's Header Auth credential (default: X-Api-Key)
VITE_API_KEY_HEADER=X-Api-Key
