      "parameters": {
        "jsCode": "// Group all rows from every sheet into one object keyed by sheet name:\n// { MIC: [...rows], waba_quality_checks: [...rows] }\nconst result = {};\nfor (const item of $input.all()) {\n  const { _sheet, ...row } = item.json;\n  if (!result[_sheet]) result[_sheet] = [];\n  result[_sheet].push(row);\n}\nreturn [{ json: result }];"
